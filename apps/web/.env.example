# DealShield AI Frontend — Environment Configuration
# Copy this file to .env.local for local development

# FastAPI Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth & Storage (Public Anon Keys Only)
# CRITICAL: NEVER put SUPABASE_SERVICE_ROLE_KEY or OPENAI_API_KEY into frontend env vars!
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
