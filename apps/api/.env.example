# DealShield AI Backend — Environment Configuration
# Copy this file to .env and configure for local development

# Application Environment
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Configuration
# Used by Team D for database connection and storage buckets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# CRITICAL: Service role key MUST NOT be exposed to client applications or version control
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Optional: Direct PostgreSQL Connection URL (Used by 'npm run db:migrate' to run migrations)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.your-project-id.supabase.co:5432/postgres

# Security & Authentication (DPDP Act 2023 & JWT Session Security)
# Used to sign session tokens for authenticated users
SECRET_KEY=dealshield-auth-secret-key-change-in-production-2026
# Salt used for anonymizing client IP addresses under Section 12 of the DPDP Act
IP_HASH_SALT=generate-a-strong-random-salt-for-ip-hashing
# Fernet (AES-128-CBC + HMAC-SHA256) key for encrypting stored chat messages at rest
ENCRYPTION_KEY=rUqpl4OBAPgr-k1M_wughKIjIBOWpJn-YTRIEq6f3Wk=

# Primary LLM: Google Gemini 3.8 Flash (Team C integration)
# Required for structured extraction, Section 7 conflict detection, and clause generation
GEMINI_API_KEY=AIzaSy-placeholder-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional / Fallback OpenAI Configuration
OPENAI_API_KEY=sk-placeholder-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Counterparty Email-OTP & Notification Service
# Options for EMAIL_BACKEND: console (prints to terminal - DEV ONLY), memory (for tests), smtp (production/staging)
REQUIRE_EMAIL_OTP=true
ALLOW_DIRECT_CONFIRM=false
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# NOTE: Real secrets belong ONLY in .env, NEVER commit credentials to version control!
# For Gmail SMTP: requires 2-Step Verification enabled and a 16-character Google App Password (not your normal Gmail login).
# Note also: Gmail has daily sending limits (500 emails/day), suitable for testing/demo use only.
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=no-reply@dealshield.local
SMTP_USE_TLS=true
OTP_TTL_MINUTES=10
SESSION_TTL_MINUTES=30
FRONTEND_BASE_URL=http://localhost:3000
