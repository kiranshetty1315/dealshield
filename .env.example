# ==============================================================================
# DealShield AI — Root Master Environment Template
# ==============================================================================
# DealShield is a monorepo consisting of:
#   1. Backend API (FastAPI): apps/api/.env
#   2. Frontend UI (Next.js):  apps/web/.env.local
#
# Follow the instructions below to configure each component.
# ==============================================================================


# ==============================================================================
# 1. BACKEND SERVICE (apps/api/.env)
# Copy these values into apps/api/.env:
# ==============================================================================

# Application & Server Configuration
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (Frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase PostgreSQL Database & Storage
# Obtain from your Supabase project dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# CRITICAL: Service role key MUST NOT be exposed to client applications or git
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Security, JWT Authentication & Message Encryption (DPDP Act 2023)
# Secret key used to sign and verify Bearer JWT session tokens
SECRET_KEY=dealshield-auth-secret-key-change-in-production-2026
# Salt used for anonymizing client IP addresses under DPDP Act Section 12
IP_HASH_SALT=dealshield-default-dev-salt-change-in-production
# AES-256 / Fernet key for encrypting chat content at rest
ENCRYPTION_KEY=rUqpl4OBAPgr-k1M_wughKIjIBOWpJn-YTRIEq6f3Wk=

# OpenAI API Key (For AI term extraction and clause generation)
OPENAI_API_KEY=sk-placeholder-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini


# ==============================================================================
# 2. FRONTEND SERVICE (apps/web/.env.local)
# Copy these values into apps/web/.env.local:
# ==============================================================================

# FastAPI Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth & Storage (Public Anon Keys Only)
# CRITICAL: NEVER place SUPABASE_SERVICE_ROLE_KEY or OPENAI_API_KEY here!
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
